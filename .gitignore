/target
**/*.rs.bk
*.jsonl
*.blobs/
*.halt
.tether/
.eval/
.env
.DS_Store
node_modules/
__pycache__/
*.egg-info/
dist/
.venv/
.pytest_cache/

# Traces written by the v0.3.0 release, kept to prove later readers still
# read them. See crates/tether-trace/tests/compat.rs.
!crates/tether-trace/tests/fixtures/*.jsonl
!crates/tether-trace/tests/fixtures/*.blobs/
